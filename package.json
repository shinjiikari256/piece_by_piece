{
  "name": "pokusochkam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/client/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/client/vite.config.ts",
    "preview": "vite preview --config apps/client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "validate:cases": "tsx scripts/validate-cases.ts",
    "generate:case": "tsx scripts/generate-case.ts",
    "touch:cases": "tsx scripts/touch-cases.ts",
    "generate:licenses": "tsx scripts/licenses.ts",
    "export:offline": "tsx scripts/export-offline.ts",
    "server:dev": "tsx watch apps/server/src/main.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate --config apps/server/drizzle.config.ts"
  },
  "dependencies": {
    "@fontsource/pt-mono": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "phaser": "3.90.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "transliteration": "^2.6.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.3.4"
}
